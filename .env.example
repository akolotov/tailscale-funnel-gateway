# Required only for the first start of a new state/ directory. Create this key
# in the Tailscale admin console; use a reusable, non-ephemeral key for this
# persistent gateway. Never commit the real .env file.
TS_AUTHKEY=

# Unique node name in your tailnet. It becomes part of the MagicDNS name.
TS_HOSTNAME=apps-gateway

# Funnel watchdog. Recovery is conservative: it runs only after repeated
# failures when Tailscale and the local Nginx proxy are both healthy.
WATCHDOG_RECOVERY_ENABLED=true
WATCHDOG_INTERVAL_SECONDS=60
WATCHDOG_FAILURE_THRESHOLD=3
WATCHDOG_RECOVERY_COOLDOWN_SECONDS=3600
WATCHDOG_SOFT_RECOVERY_WAIT_SECONDS=120
WATCHDOG_RECOVERY_WAIT_SECONDS=600
WATCHDOG_DNS_RESOLVERS=1.1.1.1 8.8.8.8
WATCHDOG_LOCAL_URL=http://127.0.0.1:8080/healthz
WATCHDOG_PUBLIC_PATH=/healthz
WATCHDOG_FUNNEL_TARGET=http://127.0.0.1:8080
WATCHDOG_FUNNEL_PORT=443
